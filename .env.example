# ---------------------------------------------------------------------------
# Society Maintenance Tracker - environment variables
# Copy to `.env` and fill in. Only DATABASE_URL and AUTH_SECRET are required;
# everything else has a safe local-development fallback.
# ---------------------------------------------------------------------------

# --- Required -------------------------------------------------------------

# PostgreSQL connection string.
# Local (docker compose up -d): postgresql://postgres:postgres@localhost:5433/society_tracker?schema=public
# Production (Neon / Supabase / Railway): use the pooled connection string.
DATABASE_URL="postgresql://postgres:postgres@localhost:5433/society_tracker?schema=public"

# Secret used to sign session JWTs. Must be at least 32 characters.
# Generate one with: openssl rand -base64 32
AUTH_SECRET="replace-with-a-long-random-string-at-least-32-chars"

# --- Optional -------------------------------------------------------------

# Public base URL of the deployed app. Used to build links inside emails.
# Falls back to http://localhost:3000, or to VERCEL_URL when deployed.
APP_URL="http://localhost:3000"

# Default age (in days) after which an unresolved complaint counts as overdue.
# Seeds the `overdue_threshold_days` setting on first run; after that the value
# is edited from Admin -> Settings and stored in the database.
OVERDUE_THRESHOLD_DAYS="5"

# Resend API key (https://resend.com - free tier). Leave blank and every email
# is written to the server console instead of being sent, so the app runs
# end-to-end with no mail account.
RESEND_API_KEY=""

# Verified "from" address for outgoing mail. Resend's shared sandbox sender
# (onboarding@resend.dev) works without domain verification but can only
# deliver to the email address that owns the Resend account.
MAIL_FROM="Society Maintenance <onboarding@resend.dev>"

# Vercel Blob read/write token (https://vercel.com/docs/storage/vercel-blob).
# Leave blank and complaint photos are written to `public/uploads` on local
# disk instead. Required in production - serverless filesystems are read-only.
BLOB_READ_WRITE_TOKEN=""

# Credentials for the admin account created by `npm run db:seed`.
SEED_ADMIN_EMAIL="admin@society.test"
SEED_ADMIN_PASSWORD="Admin@123"
